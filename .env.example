# Successor needs two server-side keys. Never commit a real .env; it is gitignored.

# ── CoinMarketCap Pro API ────────────────────────────────────
# Get from: https://pro.coinmarketcap.com/account  (the old-market check calls /v1/cryptocurrency/market-pairs/latest, a paid-plan endpoint)
CMC_API_KEY=

# ── Qwen via Alibaba DashScope (the Reader) ──────────────────
# Get from: https://modelstudio.console.alibabacloud.com/  (API keys; international endpoint)
DASHSCOPE_API_KEY=

# ── Optional ─────────────────────────────────────────────────
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen4-max
# LLM_DAILY_CAP=300           # cap on paid Reader calls per instance per day
# SERVE_STATIC=1              # local dev only: serve public/ from uvicorn
