{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/judge",
      "destination": "/judge.html"
    },
    {
      "source": "/pitch",
      "destination": "/pitch.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/architecture",
      "destination": "/architecture.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
